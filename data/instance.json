{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/schemas/instance-computer-science-knowledge-graph.schema.json",
  "title": "Instance (Computer Science) Knowledge Graph",
  "description": "Schema for a typed, directed knowledge graph of the computer-science concept of an instance.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "metadata",
    "entity_types",
    "relationship_types",
    "entities",
    "relationships"
  ],
  "properties": {
    "metadata": {
      "type": "object",
      "required": [
        "title",
        "description",
        "version",
        "schema_version",
        "source",
        "entity_count",
        "relationship_count",
        "entity_type_count",
        "relationship_type_count",
        "relationship_direction",
        "notes"
      ],
      "properties": {
        "title": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "version": {
          "type": "string"
        },
        "schema_version": {
          "const": "JSON Schema Draft 2020-12"
        },
        "source": {
          "type": "object",
          "required": [
            "title",
            "publisher",
            "license",
            "user_supplied_text",
            "last_edited"
          ],
          "properties": {
            "title": {
              "type": "string"
            },
            "publisher": {
              "type": "string"
            },
            "license": {
              "type": "string"
            },
            "user_supplied_text": {
              "type": "boolean"
            },
            "last_edited": {
              "type": "string",
              "format": "date"
            }
          },
          "additionalProperties": true
        },
        "entity_count": {
          "type": "integer",
          "minimum": 0
        },
        "relationship_count": {
          "type": "integer",
          "minimum": 0
        },
        "entity_type_count": {
          "type": "integer",
          "minimum": 0
        },
        "relationship_type_count": {
          "type": "integer",
          "minimum": 0
        },
        "relationship_direction": {
          "type": "string"
        },
        "notes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": true
    },
    "entity_types": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "relationship_types": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "entities": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "name",
          "type",
          "description",
          "properties"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*$"
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "type": {
            "type": "string",
            "minLength": 1
          },
          "description": {
            "type": "string"
          },
          "properties": {
            "type": "object"
          }
        },
        "additionalProperties": false
      }
    },
    "relationships": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "source",
          "target",
          "type",
          "description",
          "properties"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^rel_[0-9]{4,}$"
          },
          "source": {
            "type": "string",
            "minLength": 1
          },
          "target": {
            "type": "string",
            "minLength": 1
          },
          "type": {
            "type": "string",
            "minLength": 1
          },
          "description": {
            "type": "string"
          },
          "properties": {
            "type": "object"
          }
        },
        "additionalProperties": false
      }
    }
  }
}